{
    "name": "@dhyeythumar/xd-llm-connector",
    "version": "2.0.0",
    "displayName": "Adobe XD LLM Connector",
    "description": "Server that provides bridge between Adobe XD plugin and LLMs, so LLMs can query design context and generate UI code more accurately.",
    "license": "MIT",
    "private": true,
    "author": {
        "name": "Dhyey Thumar",
        "email": "dhyeythumar@gmail.com",
        "url": "https://github.com/dhyeythumar"
    },
    "type": "module",
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc",
        "setup": "npm install",
        "dev": "tsx watch src/server.ts",
        "start": "tsx src/server.ts",
        "inspector": "npx @modelcontextprotocol/inspector",
        "prepack": "npm run build"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.18.1",
        "chalk": "^5.6.2",
        "cors": "^2.8.5",
        "express": "^4.21.1",
        "uuid": "^10.0.0",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@modelcontextprotocol/inspector": "^0.16.8",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.5",
        "@types/node": "^22.19.1",
        "@types/uuid": "^10.0.0",
        "@types/ws": "^8.18.1",
        "tsx": "^4.19.2",
        "typescript": "^5.9.3"
    },
    "packageManager": "npm@11.4.2",
    "engines": {
        "node": ">=22.0.0"
    }
}
