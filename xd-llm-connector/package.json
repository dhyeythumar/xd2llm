{
    "name": "@dhyeythumar/xd-llm-connector",
    "version": "2.0.0",
    "displayName": "Adobe XD LLM Connector",
    "description": "Server that provides bridge between Adobe XD plugin and LLMs, so LLMs can query design context and generate UI code more accurately.",
    "license": "MIT",
    "author": {
        "name": "Dhyey Thumar",
        "email": "dhyeythumar@gmail.com",
        "url": "https://github.com/dhyeythumar"
    },
    "type": "module",
    "main": "src/server.js",
    "bin": {
        "xd-server": "src/server.js",
        "xd-llm-connector": "src/server.js"
    },
    "files": [
        "src/",
        "package.json",
        "README.md",
        "SETUP.md"
    ],
    "scripts": {
        "setup": "npm ci && npm link",
        "start": "node --loader ts-node/esm src/server.ts",
        "dev": "node --loader ts-node/esm --watch src/server.ts",
        "build": "tsc",
        "inspector": "npx @modelcontextprotocol/inspector"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.18.1",
        "cors": "^2.8.5",
        "express": "^4.21.1",
        "uuid": "^10.0.0",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@modelcontextprotocol/inspector": "^0.16.8",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.5",
        "@types/node": "^22.19.1",
        "@types/uuid": "^10.0.0",
        "@types/ws": "^8.18.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    },
    "packageManager": "npm@11.4.2",
    "engines": {
        "node": ">=22.0.0"
    }
}
