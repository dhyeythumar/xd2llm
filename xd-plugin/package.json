{
    "name": "@dhyeythumar/xd-plugin",
    "version": "1.0.0",
    "displayName": "Customized XD Plugin",
    "description": "Adobe XD plugin that extracts design specifications and communicates with AI assistants and Large Language Models (LLMs) for intelligent design-to-code workflows.",
    "license": "MIT",
    "author": {
        "name": "Dhyey Thumar",
        "email": "dhyeythumar@gmail.com",
        "url": "https://github.com/dhyeythumar"
    },
    "type": "commonjs",
    "main": "main.js",
    "scripts": {
        "setup": "npm ci && npm run plugin:install",
        "plugin:install": "xdpm install -o -c",
        "plugin:watch": "xdpm watch -c",
        "plugin:validate": "xdpm validate .",
        "plugin:package": "xdpm package"
    },
    "dependencies": {
        "@adobe/xdpm": "^4.1.1"
    }
}
