{
    "id": "dhyeythumar-xd-context-extractor",
    "name": "Adobe XD Context Extractor",
    "version": "1.0.0",
    "description": "Extract design context from XD mockups.",
    "languages": ["en"],
    "author": "Dhyey Thumar",
    "host": {
        "app": "XD",
        "minVersion": "59.0"
    },
    "icons": [
        {
            "width": 24,
            "height": 24,
            "path": "images/icon@1x.png"
        },
        {
            "width": 48,
            "height": 48,
            "path": "images/icon@2x.png"
        }
    ],
    "uiEntryPoints": [
        {
            "type": "panel",
            "label": "Design Context Extractor in JSON (for LLMs)",
            "panelId": "jsonDesignContextExtractor",
            "shortcut": { "mac": "Ctrl+Shift+D" }
        },
        {
            "type": "panel",
            "label": "Design Context Extractor in SCSS",
            "panelId": "scssDesignContextExtractor",
            "shortcut": { "mac": "Ctrl+Shift+S" }
        }
    ]
}
