{
    "name": "@dhyeythumar/xd-context-extractor",
    "version": "2.0.0",
    "displayName": "Adobe XD Context Extractor",
    "description": "Adobe XD plugin that extracts design context from XD mockups.",
    "license": "MIT",
    "private": true,
    "author": {
        "name": "Dhyey Thumar",
        "email": "dhyeythumar@gmail.com",
        "url": "https://github.com/dhyeythumar"
    },
    "type": "commonjs",
    "main": "main.js",
    "scripts": {
        "setup": "npm install && npm run plugin:install",
        "plugin:install": "xdpm install -o -c",
        "plugin:watch": "xdpm watch -c",
        "plugin:validate": "xdpm validate .",
        "plugin:package": "xdpm package",
        "prepack": "npm run plugin:validate"
    },
    "dependencies": {
        "@adobe/xdpm": "^4.1.1"
    }
}
